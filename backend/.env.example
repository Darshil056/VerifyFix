# VerifyFix Backend Environment Configuration
PORT=5000
FLASK_DEBUG=True
FLASK_SECRET_KEY=verifyfix-super-secret-key-change-me

# Google Gemini API Key (Primary & Only LLM Provider — used for all agents)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional for querying private repos or higher rate limits)
GITHUB_TOKEN=your_github_token_here

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=verifyfix
